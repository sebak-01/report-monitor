      "id": "assets_composition",
      "labelDe": "Anlage- + Umlaufvermögen + RAP = Bilanzsumme",
      "lhs": "fixed_assets_total + current_assets_total + prepaid_expenses",
      "rhs": "total_assets",
      "views": [
        "balance"
      ]
    },
